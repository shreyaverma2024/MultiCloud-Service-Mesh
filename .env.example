# ---------------------------------------------------------------------------
# Multi-Cloud Service Mesh - environment template
# Copy values are generated by:  node scripts/init-secrets.js
# NEVER commit the real .env file. Placeholders only in this file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
MESH_MODE=split
# Docker Compose profile activated by default. Use scripts/start-bundle.cmd for
# the one-container Render bundle instead.
COMPOSE_PROFILES=split

# --- PostgreSQL (one server, two logical databases) ------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=__GENERATE__
AWS_DB_NAME=aws_library
AWS_DB_USER=aws_app
AWS_DB_PASSWORD=__GENERATE__
RENDER_DB_NAME=render_library
RENDER_DB_USER=render_app
RENDER_DB_PASSWORD=__GENERATE__
# Set to true only when PostgreSQL TLS is configured (production guide).
# Cloud deployment requires DB_SSL=true and verified certificates.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Trust a self-managed CA without disabling verification. Prefer DB_SSL_CA_PATH
# on Docker deployments and on Render Secret Files. DB_SSL_CA_PEM accepts the
# PEM text directly (use \n for line breaks in a single-line .env value).
DB_SSL_CA_PATH=
DB_SSL_CA_PEM=
# Optional TLS server name when POSTGRES_HOST is an IP but the certificate was
# issued for a DNS name.
DB_SSL_SERVERNAME=
# Cloud deployment only: rewrite pg_hba.conf so every TCP connection must use
# TLS. Local development keeps the default rules.
MESH_REQUIRE_DB_TLS=false

# --- Exactly one Redis instance (never publish port 6379) -----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__

# --- Authenticated Cache API ----------------------------------------------
CACHE_API_URL=http://cache-api:4100
CACHE_API_PORT=4100
CACHE_API_KEY=__GENERATE__
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_MAX_TTL_SECONDS=3600
CACHE_API_TIMEOUT_MS=1500

# --- Control Plane --------------------------------------------------------
CONTROL_PLANE_URL=http://control-plane:4000
CONTROL_PLANE_PORT=4000
# Loopback by default. Set to 0.0.0.0 only when Render must reach the Control
# Plane directly (AWS EC2 deployment with docker-compose.deploy.yml).
CONTROL_PLANE_BIND=127.0.0.1
CONTROL_PLANE_ADMIN_TOKEN=__GENERATE__
CONTROL_PLANE_SERVICE_TOKEN=__GENERATE__
CONTROL_PLANE_READ_TOKEN=__GENERATE__
HEARTBEAT_INTERVAL_MS=3000
COMPONENT_STALE_MS=12000

# --- Cross-cloud application authentication (separate per direction) ------
AWS_TO_RENDER_HMAC_SECRET=__GENERATE__
RENDER_TO_AWS_HMAC_SECRET=__GENERATE__
HMAC_MAX_SKEW_MS=300000

# --- API Gateway ----------------------------------------------------------
# Local development binds 0.0.0.0. Cloud deployment uses the Nginx TLS proxy
# and docker-compose.deploy.yml forces loopback, so the gateway is not public.
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_TIMEOUT_MS=2500
GATEWAY_RETRIES=1
GATEWAY_BREAKER_FAILURES=5
GATEWAY_BREAKER_SUCCESSES=2
GATEWAY_BREAKER_COOLDOWN_MS=10000

# --- Sidecars (defaults; each sidecar can override) -----------------------
SIDECAR_TIMEOUT_MS=2000
SIDECAR_RETRIES=2
SIDECAR_RETRY_DELAY_MS=100
SIDECAR_BREAKER_FAILURES=5
SIDECAR_BREAKER_SUCCESSES=2
SIDECAR_BREAKER_COOLDOWN_MS=10000

# --- Service ports (internal Docker network) ------------------------------
BOOK_SERVICE_PORT=4101
BORROW_SERVICE_PORT=4102
NOTIFICATION_SERVICE_PORT=4103
BOOK_REPLICA_SERVICE_PORT=4104
MEMBER_SERVICE_PORT=4105
BOOK_PRIMARY_SIDECAR_PORT=5101
BORROW_SIDECAR_PORT=5102
NOTIFICATION_SIDECAR_PORT=5103
BOOK_REPLICA_SIDECAR_PORT=5104
MEMBER_SIDECAR_PORT=5105

# --- Internal service discovery ------------------------------------------
BOOK_SIDECAR_URL=http://book-primary-sidecar:5101
BORROW_SIDECAR_URL=http://borrow-sidecar:5102
NOTIFICATION_SIDECAR_URL=http://notification-sidecar:5103
BOOK_REPLICA_SIDECAR_URL=http://book-replica-sidecar:5104
MEMBER_SIDECAR_URL=http://member-sidecar:5105
AWS_GATEWAY_URL=http://api-gateway:8080

# --- Render one-container bundle -----------------------------------------
RENDER_INGRESS_PORT=8081
RENDER_INGRESS_TIMEOUT_MS=6000
RENDER_SUPERVISOR_PORT=5300
RENDER_SUPERVISOR_TOKEN=__GENERATE__
RENDER_INGRESS_REQUIRE_HMAC=true
# Both the API Gateway and Borrow Service may call Render-side sidecars. Each
# request is still individually signed and replay-protected.
RENDER_INGRESS_ALLOWED_CLIENTS=api-gateway,borrow-service
# Locally the gateway reaches the Render bundle through this URL. The sidecars
# advertise their ingress-prefixed paths to the Control Plane.
RENDER_PUBLIC_BASE_URL=http://render-web:8081

# --- Dashboard backend-for-frontend --------------------------------------
# Cloud deployment keeps the dashboard on loopback; use an SSH tunnel.
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=3000
DASHBOARD_POLL_INTERVAL_MS=2000
